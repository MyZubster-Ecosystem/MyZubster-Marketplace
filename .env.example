NODE_ENV=development
PORT=4000

# Required for authentication and payment-intent persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/myzubster
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Required outside tests. Generate a long random value; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Optional independent escrow boundary. External settlement still remains fail-closed.
GATEWAY_URL=http://127.0.0.1:3001

# Canonical MYZ identity state.
# Current production-safe default is internal_credit: MYZ is a platform reward/accounting credit,
# not an externally tradable asset.
# Future modes require separate legal/compliance, security and provider review.
MYZ_ASSET_MODE=internal_credit

# redemption_bridge mode requires an explicitly reviewed settlement/redemption rail identifier.
# Example values must represent a real reviewed integration contract, not a made-up provider name.
MYZ_REDEMPTION_RAIL=

# Canonical internal MYZ ledger bridge.
MYZ_LEDGER_ADAPTER_ENABLED=false
MYZ_LEDGER_ADAPTER_APPROVED=false
MYZ_LEDGER_API_URL=
MYZ_LEDGER_API_KEY=
MYZ_LEDGER_API_TIMEOUT_MS=8000
MYZ_LEDGER_ACCOUNT_PREFIX=marketplace:user:

# Read-only operator reconciliation reporting.
MYZ_RECONCILIATION_OPERATOR_TOKEN=

# Trusted read-only canonical-ledger evidence for repair preview.
MYZ_RECONCILIATION_LEDGER_EVIDENCE_ENABLED=false
MYZ_RECONCILIATION_LEDGER_EVIDENCE_APPROVED=false

# Trusted read-only provider-settlement evidence for repair preview.
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_ENABLED=false
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_APPROVED=false
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_NAME=
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_URL=
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_API_KEY=
MYZ_RECONCILIATION_PROVIDER_EVIDENCE_TIMEOUT_MS=8000

# Persistent Marketplace worker registry read facade.
# GET /api/operations/lookup is read-only and requires this dedicated service token.
MYZ_WORKER_REGISTRY_READ_TOKEN=

# Provider settlement worker lifecycle.
# Every redemption settlement now records queued/running/retrying/completed/failed state in the
# persistent worker registry. Automatic retries remain fail-closed: a provider error is retried
# only when the reviewed provider adapter explicitly sets error.retryable=true.
MYZ_SETTLEMENT_WORKER_OWNER=marketplace-settlement-worker
MYZ_SETTLEMENT_WORKER_LEASE_MS=30000
MYZ_SETTLEMENT_WORKER_MAX_ATTEMPTS=1
MYZ_SETTLEMENT_WORKER_RETRY_DELAY_MS=0

# Trusted read-only in-flight/worker evidence for repair preview.
# To use the Marketplace's own registry facade, point the URL at this service's /api base
# and set the API key to the same secret as MYZ_WORKER_REGISTRY_READ_TOKEN.
# Example local URL: http://127.0.0.1:4000/api
MYZ_RECONCILIATION_INFLIGHT_EVIDENCE_ENABLED=false
MYZ_RECONCILIATION_INFLIGHT_EVIDENCE_APPROVED=false
MYZ_RECONCILIATION_INFLIGHT_EVIDENCE_URL=
MYZ_RECONCILIATION_INFLIGHT_EVIDENCE_API_KEY=
MYZ_RECONCILIATION_INFLIGHT_EVIDENCE_TIMEOUT_MS=8000

# external_asset mode requires both a real external asset identifier and network.
CONVERSION_MYZ_EXTERNAL_ASSET_ID=
MYZ_EXTERNAL_NETWORK=

# MYZ conversion gateway.
CONVERSION_PROVIDER_ENABLED=false
CONVERSION_PROVIDER_APPROVED=false
CONVERSION_PROVIDER_NAME=external-provider
CONVERSION_PROVIDER_URL=
CONVERSION_PROVIDER_API_KEY=
CONVERSION_PROVIDER_TIMEOUT_MS=8000

# First technical provider candidate: Coinbase Advanced Trade.
CONVERSION_COINBASE_CANDIDATE_ENABLED=false
CONVERSION_COINBASE_SANDBOX=true

# Marketplace service fee in basis points. 100 bps = 1.00%.
MYZ_CONVERSION_FEE_BPS=100

# Payout, batch execution, subscription renewal and repeater settlement remain disabled
# until an independently verified provider integration is implemented and tested.
