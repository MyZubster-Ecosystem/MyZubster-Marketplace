NODE_ENV=development
PORT=4000

# Required for authentication and payment-intent persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/myzubster
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Required outside tests. Generate a long random value; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Optional independent escrow boundary. External settlement still remains fail-closed.
GATEWAY_URL=http://127.0.0.1:3001

# MYZ conversion gateway. All three enablement conditions must be explicit before
# the HTTP provider adapter is registered. Keep APPROVED=false until legal/compliance
# and provider due diligence are complete for the deployment jurisdiction.
CONVERSION_PROVIDER_ENABLED=false
CONVERSION_PROVIDER_APPROVED=false
CONVERSION_PROVIDER_NAME=external-provider
CONVERSION_PROVIDER_URL=
CONVERSION_PROVIDER_API_KEY=
CONVERSION_PROVIDER_TIMEOUT_MS=8000

# Marketplace service fee in basis points, applied to the provider-normalized
# gross recipient amount. 100 bps = 1.00%. Provider fees remain separately disclosed.
MYZ_CONVERSION_FEE_BPS=100

# Payout, batch execution, subscription renewal and repeater settlement remain disabled
# until an independently verified provider integration is implemented and tested.
